<?xml version="1.0" encoding="UTF-8"?>
<!-- 日志输出：控制台始终输出；prod 追加按大小与日期滚动的文件，保留 14 天、总量 1GB。
     只记录请求关联 ID、事件 ID 等定位字段，不记录请求体、Cookie、Authorization、CSRF token、
     密码或消息 payload。 -->
<configuration>
    <springProperty scope="context" name="LOG_FILE" source="shop.logging.file"
                    defaultValue="/app/logs/shop.log"/>
    <property name="SHOP_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] [%X{requestId}] %logger{40} - %replace(%msg){'(?i)((?:password|passwd|token|authorization|cookie)\s*[=:]\s*)\S+', '$1***'}%n%ex"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${SHOP_PATTERN}</pattern>
        </encoder>
    </appender>

    <springProfile name="prod">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_FILE}</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <maxHistory>14</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>${SHOP_PATTERN}</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
