# 复制为根目录 .env，然后填写两个密码。密码可用单引号包裹，$ / # 按字面量读取。
MYSQL_USERNAME=root
MYSQL_PASSWORD=''
RABBITMQ_USERNAME=shop
RABBITMQ_PASSWORD=''

# 两个逻辑库都在 Windows 本机 MySQL 3306，不创建 MySQL 容器。
SHOP_DB_NAME=test_shop
NOTIFICATION_DB_NAME=test_shop_notification

# 通知可使用独立账号；留空时沿用 MYSQL_USERNAME / MYSQL_PASSWORD。
NOTIFICATION_DB_USERNAME=
NOTIFICATION_DB_PASSWORD=

# 已有旧容器占用时，先停止对应旧容器，或修改这里的端口。
SHOP_HTTP_PORT=8080
RABBITMQ_MANAGEMENT_PORT=15672
